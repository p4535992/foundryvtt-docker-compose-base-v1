# Local settings. Copy via start_all.sh; never commit .env.
# Set the four credentials. Use single quotes around literal values,
# especially those containing $ or #. Do not use inline comments.
STACK_PROJECT_NAME=foundryvtt-dev

FOUNDRY03_IMAGE_TAG=14
FOUNDRY03_HOSTNAME=foundry03
FOUNDRY03_TIMEZONE=Europe/Rome
FOUNDRY03_BIND_IP=127.0.0.1
FOUNDRY03_HOST_PORT=30000
FOUNDRY03_MEM_LIMIT=1152m

FOUNDRY03_USERNAME='REPLACE_ME_FOUNDRY_USERNAME'
FOUNDRY03_PASSWORD='REPLACE_ME_FOUNDRY_PASSWORD'
FOUNDRY03_ADMIN_KEY='REPLACE_ME_ADMIN_KEY'
FOUNDRY03_LICENSE_KEY='REPLACE_ME_LICENSE_KEY'

FOUNDRY03_TELEMETRY=false
FOUNDRY03_LOG_SIZE=64m
FOUNDRY03_MAX_LOGS=10
FOUNDRY03_LANGUAGE=en.core
FOUNDRY03_COMPRESS_WEBSOCKET=false
FOUNDRY03_PRESERVE_CONFIG=false
FOUNDRY03_NO_BACKUPS=false
FOUNDRY03_WORLD=
FOUNDRY03_LOG_MAX_SIZE=10m
FOUNDRY03_LOG_MAX_FILES=5
